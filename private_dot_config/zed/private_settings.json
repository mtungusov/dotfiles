{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "vim_mode": true,
  // --- Langs and LSP ---
  "edit_predictions": {
    "mode": "subtle", // or "eager"
  },
  // "show_edit_predictions": false,
  "languages": {
    "Go": {
      "format_on_save": "on",
      "language_servers": ["gopls", "golangci-lint"],
    },
    "Python": {
      "indent_guides": {
        "enabled": true,
      },
    },
  },
  "lsp": {
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "golangci-lint",
          "run",
          "--output.json.path",
          "stdout",
          "--show-stats=false",
          "--output.text.path="
      ],
      },
    },
  },
  // --- Langs and LSP End ---
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "buffer_font_family": "Maple Mono NF",
  "buffer_font_fallbacks": [".ZedMono"],
  "buffer_font_size": 16.0,
  "buffer_font_features": {
    "calt": false,
  },
  "buffer_line_height": "comfortable",
  "preferred_line_length": 120,
  "markdown_preview_font_family": "Iosevka Comfy Motion Duo",
  "markdown_preview_font_size": 18,
  "ui_font_family": ".ZedSans",
  "ui_font_size": 14,
  "theme": {
    "mode": "dark",
    "light": "Maple Light",
    "dark": "One Dark Pro Night Flat",
    // "dark": "Maple Dark",
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.venv",
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/target",
    "**/.rope*",
    "**/*_cache",
    "**/__pycache__",
    "**/.*-version",
    "**/.DS_Store",
  ],
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "indent_guides": {
    "enabled": false,
  },
  "soft_wrap": "bounded",
  "terminal": {
    "dock": "right",
    "font_size": 14,
    "line_height": "standard",
    "toolbar": {
      "breadcrumbs": false,
    },
  },
}
